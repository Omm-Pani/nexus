{
  "name": "@nexus/schema",
  "version": "0.0.0",
  "description": "Shared type contracts for Nexus.",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.typecheck.json --pretty false"
  },
  "engines": {
    "node": ">=20"
  }
}
