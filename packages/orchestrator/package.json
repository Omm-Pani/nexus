{
  "name": "@nexus/orchestrator",
  "version": "0.0.0",
  "description": "Playwright lifecycle and event orchestration for Nexus.",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "bin": {
    "nexus": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.typecheck.json --pretty false",
    "serve": "node dist/server.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@nexus/extractor": "workspace:*",
    "@nexus/schema": "workspace:*",
    "express": "^5.1.0",
    "playwright": "^1.54.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.16.5",
    "@types/ws": "^8.18.1",
    "typescript": "5.8.3"
  }
}
