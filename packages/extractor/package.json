{
  "name": "@nexus/extractor",
  "version": "0.0.0",
  "description": "Deterministic in-process DOM extraction boundary for Nexus.",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./artifact": {
      "types": "./dist/artifact/write-artifact.d.ts",
      "import": "./dist/artifact/write-artifact.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.typecheck.json --pretty false"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@nexus/schema": "workspace:*",
    "playwright": "^1.54.1"
  },
  "devDependencies": {
    "@types/node": "^22.16.5",
    "typescript": "5.8.3"
  }
}
